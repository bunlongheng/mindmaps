# ---- Client (browser): Google sign-in via Google Identity Services ----
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com   # the Mindmaps OAuth client ID; renders the Google button

# ---- Client (browser): local-dev owner identity (dev bundle only, stripped from prod) ----
VITE_DEV_USER_EMAIL=dev@example.com                     # owner email auto-signed-in on localhost during `npm run dev`
VITE_DEV_USER_NAME=Dev User                             # display name for that dev session
VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000000   # owner user id; match your DATABASE owner row to see your maps

# ---- Server (Vercel serverless functions in api/) ----
DATABASE_URL=postgres://user:pass@host:5432/db  # Postgres for map storage
DATABASE_CA_CERT=                               # PEM CA cert for TLS verify (blank = skip verify, dev only)
ANTHROPIC_API_KEY=sk-ant-...                    # Claude API key for AI generation
MINDMAP_AI_API_KEY=                             # bearer key for the external agent import API
MINDMAPS_API_SECRET=                            # bearer service key for the API + MCP (preferred over MINDMAP_AI_API_KEY)
MINDMAPS_API_SECRET_PARTNER=                    # optional second bearer service key for a partner agent
MINDMAP_AI_API_KEY_PARTNER=                     # optional partner key for the external agent import API
MINDMAP_APP_URL=                                # base URL for returned map links + the CORS allow-origin (defaults to the prod host)
MINDMAP_JWT_SECRET=                             # HMAC secret used to sign/verify session tokens
MINDMAP_AUTH_EMAIL=you@example.com              # the single owner email allowed to sign in with Google
MINDMAP_USER_ID=                                # owner user id issued in the session token
MINDMAP_TOKEN_MIN_IAT=                          # optional unix timestamp; set to now to instantly revoke all outstanding sessions
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com # server-side: audience the Google ID token must match at /api/auth

# ---- Optional ----
NOTIFY_APP=                                      # lib/share-alert.js: this app's key in Notify's apps.json
NOTIFY_URL=                                      # Notify endpoint that logs share-link views
NOTIFY_SECRET=                                   # shared secret for that Notify endpoint
MINDMAP_SMOKE_SAMPLE=                            # scripts/smoke-prod.mjs: how many maps to sample (default 8)
